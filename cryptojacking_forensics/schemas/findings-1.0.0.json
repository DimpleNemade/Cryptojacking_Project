{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DimpleNemade/Cryptojacking_Project/schemas/findings-1.0.0.json",
  "title": "cryptojacking-forensics findings document",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id", "finding_type", "source", "rule_id", "rule_name",
          "matched_indicator", "matched_indicator_sha256", "offset",
          "evidence_strength", "confidence", "explanation", "evidence_reference",
          "finding_group_id", "corroborates_finding_id", "independent_indicator",
          "correlation_note", "limitations"
        ],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^F-[0-9]{4,}$" },
          "finding_type": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["yara", "strings"] },
          "rule_id": { "type": ["string", "null"] },
          "rule_name": { "type": ["string", "null"] },
          "matched_indicator": { "type": ["string", "null"] },
          "matched_indicator_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "offset": { "type": ["integer", "null"], "minimum": 0 },
          "evidence_strength": { "enum": ["WEAK", "MEDIUM", "STRONG"] },
          "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "explanation": { "type": "string", "minLength": 1 },
          "evidence_reference": { "type": "string", "minLength": 1 },
          "finding_group_id": { "type": "string", "pattern": "^G-[0-9]{4,}$" },
          "corroborates_finding_id": {
            "type": ["string", "null"],
            "pattern": "^F-[0-9]{4,}$"
          },
          "independent_indicator": { "type": "boolean" },
          "correlation_note": { "type": "string", "minLength": 1 },
          "limitations": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
