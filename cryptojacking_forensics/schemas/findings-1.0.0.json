{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DimpleNemade/Cryptojacking_Project/schemas/findings-1.0.0.json",
  "title": "cryptojacking-forensics findings list",
  "version": "1.0.0",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["finding_id", "finding_type", "source", "evidence_strength", "confidence", "corroborates_finding_id", "independent_indicator", "limitations"],
    "properties": {
      "finding_id": { "type": "string" },
      "finding_type": { "type": "string" },
      "source": { "type": "string" },
      "rule_id": { "type": ["string", "null"] },
      "rule_name": { "type": ["string", "null"] },
      "matched_indicator": { "type": ["string", "null"] },
      "offset": { "type": ["integer", "null"] },
      "evidence_strength": { "type": "string", "enum": ["WEAK", "MEDIUM", "STRONG"] },
      "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
      "explanation": { "type": "string" },
      "evidence_reference": { "type": "string" },
      "finding_group_id": { "type": "string" },
      "corroborates_finding_id": { "type": ["string", "null"] },
      "independent_indicator": { "type": "boolean" },
      "correlation_note": { "type": "string" },
      "limitations": { "type": "string" }
    }
  }
}
