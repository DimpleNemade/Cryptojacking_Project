{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DimpleNemade/Cryptojacking_Project/schemas/manifest-1.0.0.json",
  "title": "cryptojacking-forensics manifest",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tool", "case_id", "run_id", "started_at", "finished_at",
    "analysis_status", "evidence", "engine", "rule_pack", "limits", "stages",
    "outputs", "warnings", "errors", "truncation", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "cryptojacking-forensics" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "analysis_status": { "enum": ["SUCCESS", "PARTIAL", "FAILED", "INTEGRITY_FAILURE"] },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "input_file", "input_file_display", "size", "sha256_before", "sha256_after",
        "hash_verification", "opened_read_only", "accessed_at", "identity_before",
        "identity_after", "observed_controls", "control_limitations", "external_modification"
      ],
      "properties": {
        "input_file": { "type": ["string", "null"] },
        "input_file_display": { "type": "string", "minLength": 1 },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "sha256_before": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "sha256_after": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "hash_verification": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "opened_read_only": { "type": "boolean" },
        "accessed_at": { "type": ["string", "null"], "format": "date-time" },
        "identity_before": { "$ref": "#/definitions/fileIdentity" },
        "identity_after": { "$ref": "#/definitions/fileIdentityNullable" },
        "observed_controls": { "type": "array", "items": { "type": "string" } },
        "control_limitations": { "type": "array", "items": { "type": "string" } },
        "external_modification": { "enum": ["NONE", "DETECTED", "NOT_CHECKED", "UNKNOWN"] }
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "package"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 }
      }
    },
    "rule_pack": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "digest", "rule_file_count", "files"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rule_file_count": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^/\\\\]+$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": [
        "total_timeout_seconds", "max_input_bytes", "max_yara_matches",
        "max_extracted_strings", "max_extracted_string_bytes",
        "max_single_string_bytes", "max_matched_value_characters", "min_string_length"
      ],
      "properties": {
        "total_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "max_yara_matches": { "type": "integer", "minimum": 1 },
        "max_extracted_strings": { "type": "integer", "minimum": 1 },
        "max_extracted_string_bytes": { "type": "integer", "minimum": 1 },
        "max_single_string_bytes": { "type": "integer", "minimum": 1 },
        "max_matched_value_characters": { "type": "integer", "minimum": 1 },
        "min_string_length": { "type": "integer", "minimum": 1 }
      }
    },
    "stages": {
      "type": "object", "additionalProperties": false,
      "required": ["scan", "strings"],
      "properties": {
        "scan": { "enum": ["SUCCESS", "PARTIAL", "FAILED", "SKIPPED"] },
        "strings": { "enum": ["SUCCESS", "PARTIAL", "FAILED", "SKIPPED"] }
      }
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["report_dir", "privacy_mode", "artifact_hashes"],
      "properties": {
        "report_dir": { "type": ["string", "null"] },
        "privacy_mode": { "enum": ["safe", "raw-opt-in"] },
        "artifact_hashes": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^/\\\\]+$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "truncation": {
      "type": "object", "additionalProperties": false,
      "required": ["scan_truncated", "strings_truncated"],
      "properties": {
        "scan_truncated": { "type": "boolean" },
        "strings_truncated": { "type": "boolean" }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "definitions": {
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "size", "mtime"],
      "properties": {
        "device": { "type": "integer" },
        "inode": { "type": "integer" },
        "size": { "type": "integer", "minimum": 0 },
        "mtime": { "type": "number" }
      }
    },
    "fileIdentityNullable": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "size", "mtime"],
      "properties": {
        "device": { "type": ["integer", "null"] },
        "inode": { "type": ["integer", "null"] },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "mtime": { "type": ["number", "null"] }
      }
    }
  }
}
