{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DimpleNemade/Cryptojacking_Project/schemas/summary-1.0.0.json",
  "title": "cryptojacking-forensics summary",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "run_id", "analysis_status", "hash_verification",
    "input_sha256_before", "input_sha256_after", "finding_count",
    "independent_indicator_count", "evidence_strength", "explanation", "warnings",
    "errors", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "analysis_status": { "enum": ["SUCCESS", "PARTIAL", "FAILED", "INTEGRITY_FAILURE"] },
    "hash_verification": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "input_sha256_before": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "input_sha256_after": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "finding_count": { "type": "integer", "minimum": 0 },
    "independent_indicator_count": { "type": "integer", "minimum": 0 },
    "evidence_strength": { "enum": ["NONE", "WEAK", "MEDIUM", "STRONG", "UNDETERMINED"] },
    "explanation": { "type": "string", "minLength": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
